[Unit]
Description=fiftyfm weekly historical Billboard playlist
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/fiftyfm/env
Environment=FIFTYFM_STATE_PATH=/var/lib/fiftyfm/state.json
StateDirectory=fiftyfm
ExecStart=/opt/fiftyfm/.venv/bin/fiftyfm run
